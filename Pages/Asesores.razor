    private void ToggleFilter() => showFilter = !showFilter;

    private void FilterAsesores()
    {
        filteredAsesores = asesores.Where(a =>
            (string.IsNullOrWhiteSpace(searchName) || a.Nombre?.Contains(searchName, StringComparison.OrdinalIgnoreCase) == true) &&
            (!searchEspecialidad.HasValue || a.Especialidad == searchEspecialidad) &&
            (!searchEstablecimiento.HasValue || a.EstablecimientosId == searchEstablecimiento) &&
            (!searchEmpresa.HasValue || a.EmpresaId == searchEmpresa)
        ).ToList();
    }

    private async Task CreateAsesor()
    {
        if (nuevoAsesor != null)
        {
            nuevoAsesor.Id = asesores.Any() ? asesores.Max(a => a.Id) + 1 : 1;
            asesores.Add(nuevoAsesor);
            FilterAsesores();
            nuevoAsesor = new AsesoresModel();
            HideCreateModal();
        }
    }

    private void ShowCreateModal() => showCreateModal = true;

    private void HideCreateModal()
    {
        showCreateModal = false;
        nuevoAsesor = new AsesoresModel();
    }

    private void ShowEditModal(AsesoresModel asesor)
    {
        asesorEditar = new AsesoresModel
            {
                Id = asesor.Id,
                Nombre = asesor.Nombre,
                Especialidad = asesor.Especialidad,
                EstablecimientosId = asesor.EstablecimientosId,
                EmpresaId = asesor.EmpresaId
            };
        showEditModal = true;
    }

    private void HideEditModal()
    {
        showEditModal = false;
        asesorEditar = new AsesoresModel();
    }

    private async Task UpdateAsesor()
    {
        var asesor = asesores.FirstOrDefault(a => a.Id == asesorEditar.Id);
        if (asesor != null)
        {
            asesor.Nombre = asesorEditar.Nombre;
            asesor.Especialidad = asesorEditar.Especialidad;
            asesor.EstablecimientosId = asesorEditar.EstablecimientosId;
            asesor.EmpresaId = asesorEditar.EmpresaId;
        }
        FilterAsesores();
        HideEditModal();
    }

    private async Task DeleteAsesor(long id)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar este asesor?");
        if (confirm)
        {
            asesores.RemoveAll(a => a.Id == id);
            FilterAsesores();
        }
    }

    public class AsesoresModel
    {
        public long Id { get; set; }
        public string? Nombre { get; set; }
        public int? Especialidad { get; set; }
        public int? EstablecimientosId { get; set; }
        public int? EmpresaId { get; set; }
    }
}
